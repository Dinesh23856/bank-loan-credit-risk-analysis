DATABASE_URL=mysql+pymysql://username:password@localhost:3306/bank_loan_db
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=60
FRONTEND_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
ADMIN_NAME=Administrator

# Enterprise Encryption & Decryption (MultiFernet URL-safe base64-encoded 32-byte key)
FIELD_ENCRYPTION_KEY=replace-with-fernet-urlsafe-base64-key
FIELD_ENCRYPTION_KEY_FALLBACK=

# Asynchronous Task Queue (Optional Redis URL; defaults to high-performance ThreadPool if unreachable)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting Configuration (slowapi)
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_PREDICT=30/minute
RATE_LIMIT_PDF=15/minute
RATE_LIMIT_ASYNC=20/minute
RATE_LIMIT_CHAT=30/minute

# Banking AI Assistant (Gemini 3.5 Flash Lite)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=25

